# מפתח API של Anthropic ליצירת השאלות (או השאירו ריק אם קיים פרופיל `ant auth login`)
ANTHROPIC_API_KEY=

# פורט השרת (ברירת מחדל 3000)
PORT=3000

# סיסמת אדמין — אופציונלית בפיתוח, חובה בפריסה לאינטרנט!
# כשמוגדרת, ניהול חידונים ופתיחת משחקים דורשים אותה (הצטרפות שחקנים נשארת חופשית)
ADMIN_PASSWORD=

# תיקיית נתונים (ברירת מחדל server/data; בענן — נתיב ה-volume, למשל /data)
# DATA_DIR=/data
